{
  "name": "study-workbench",
  "version": "0.6.0",
  "private": true,
  "description": "将学习材料转为每日学习计划的本地桌面应用",
  "author": "Study Workbench",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test services.test.cjs assessment.test.cjs tutoring.test.cjs i18n.test.cjs language-generation.test.cjs schedule.test.cjs planning.test.cjs cadence.test.cjs reading.test.cjs ocr.test.cjs",
    "test:desktop": "electron desktop.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check services.cjs && node --check app.js && node --check exampass.cjs && node --check assessment.cjs && node --check tutoring.cjs && node --check i18n.js && node --check ui-messages.js && node --check service-messages.js && node --check schedule.js && node --check cadence.cjs && node --check ocr.cjs && node --check document-reading.cjs",
    "pack": "electron-builder --dir",
    "build:mac": "electron-builder --mac zip",
    "build:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.studyworkbench.desktop",
    "productName": "学习工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "services.cjs",
      "schedule.js",
      "cadence.cjs",
      "ocr.cjs",
      "document-reading.cjs",
      "pdf-reading.SKILL.md",
      "ppt-reading.SKILL.md",
      "chi_sim.traineddata.gz",
      "eng.traineddata.gz",
      "ocr-LICENSE.txt",
      "assessment.cjs",
      "tutoring.cjs",
      "i18n.js",
      "ui-messages.js",
      "service-messages.js",
      "index.html",
      "styles.css",
      "app.js",
      "package.json",
      "exampass.cjs",
      "exampass-LICENSE.txt"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "files": [
        "main.cjs",
        "preload.cjs",
        "services.cjs",
        "schedule.js",
        "cadence.cjs",
        "ocr.cjs",
        "document-reading.cjs",
        "pdf-reading.SKILL.md",
        "ppt-reading.SKILL.md",
        "chi_sim.traineddata.gz",
        "eng.traineddata.gz",
        "ocr-LICENSE.txt",
        "assessment.cjs",
        "tutoring.cjs",
        "i18n.js",
        "ui-messages.js",
        "service-messages.js",
        "index.html",
        "styles.css",
        "app.js",
        "package.json",
        "exampass.cjs",
        "exampass-LICENSE.txt",
        "!node_modules/@napi-rs/canvas-win32-*/**"
      ],
      "target": [
        "zip"
      ]
    },
    "win": {
      "files": [
        "main.cjs",
        "preload.cjs",
        "services.cjs",
        "schedule.js",
        "cadence.cjs",
        "ocr.cjs",
        "document-reading.cjs",
        "pdf-reading.SKILL.md",
        "ppt-reading.SKILL.md",
        "chi_sim.traineddata.gz",
        "eng.traineddata.gz",
        "ocr-LICENSE.txt",
        "assessment.cjs",
        "tutoring.cjs",
        "i18n.js",
        "ui-messages.js",
        "service-messages.js",
        "index.html",
        "styles.css",
        "app.js",
        "package.json",
        "exampass.cjs",
        "exampass-LICENSE.txt",
        "!node_modules/@napi-rs/canvas-darwin-*/**"
      ],
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "chi_sim.traineddata.gz",
      "eng.traineddata.gz",
      "node_modules/regenerator-runtime/**",
      "node_modules/is-url/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/bmp-js/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/zlibjs/**"
    ]
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "pdf-parse": "2.4.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
