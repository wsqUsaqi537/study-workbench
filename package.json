{
  "name": "study-workbench",
  "version": "0.3.1",
  "private": true,
  "description": "将学习材料转为每日学习计划的本地桌面应用",
  "author": "Study Workbench",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test services.test.cjs assessment.test.cjs tutoring.test.cjs",
    "test:desktop": "electron desktop.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check services.cjs && node --check app.js && node --check exampass.cjs && node --check assessment.cjs && node --check tutoring.cjs",
    "pack": "electron-builder --dir",
    "build:mac": "electron-builder --mac zip",
    "build:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.studyworkbench.desktop",
    "productName": "学习工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "services.cjs",
      "assessment.cjs",
      "tutoring.cjs",
      "index.html",
      "styles.css",
      "app.js",
      "package.json",
      "exampass.cjs",
      "exampass-LICENSE.txt"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "files": [
        "main.cjs",
        "preload.cjs",
        "services.cjs",
        "assessment.cjs",
        "tutoring.cjs",
        "index.html",
        "styles.css",
        "app.js",
        "package.json",
        "exampass.cjs",
        "exampass-LICENSE.txt",
        "!node_modules/@napi-rs/canvas-win32-*/**"
      ],
      "target": [
        "zip"
      ]
    },
    "win": {
      "files": [
        "main.cjs",
        "preload.cjs",
        "services.cjs",
        "assessment.cjs",
        "tutoring.cjs",
        "index.html",
        "styles.css",
        "app.js",
        "package.json",
        "exampass.cjs",
        "exampass-LICENSE.txt",
        "!node_modules/@napi-rs/canvas-darwin-*/**"
      ],
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
